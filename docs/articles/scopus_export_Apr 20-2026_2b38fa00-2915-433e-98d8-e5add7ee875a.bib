@ARTICLE{Gür2026895,
	author = {Gür, Yunus Emre and Ünal, Emre},
	title = {The Impact of News Sentiment on the Bitcoin Price via Machine Learning and Deep Learning-Based NLP Models},
	year = {2026},
	journal = {Journal of Forecasting},
	volume = {45},
	number = {3},
	pages = {895 - 923},
	doi = {10.1002/for.70068},
	url = {https://www.scopus.com/pages/publications/105022653760?origin=resultslist},
	abstract = {This paper employs deep learning and machine learning-based NLP models to investigate the impact of the news sentiment on the Bitcoin price. The lagged Bitcoin variables, news indicators, macroeconomic, and financial factors were taken into account to explain the importance of news sentiment on the Bitcoin price. Moreover, FinBERT-based sentiment scores and semantic features extracted from over 650,000 financial news headlines were integrated with financial and macroeconomic variables. The importance scores of the investigation showed that Bitcoin was largely explained by its lagged price movements, which suggests the speculative nature of the cryptocurrency. However, the investigation also revealed that Bitcoin was significantly influenced by the news sentiment score. In other words, the paper indicates that the movements in the Bitcoin price can be predominantly explained by the news sentiment. Advanced hybrid models (all ML and DL models with the addition of variables obtained with the FinBERT model) were optimized using Optuna and RandomizedSearchCV. The FinBERT-LSTM model achieved the best prediction accuracy. Nevertheless, the main findings indicated that the response of the Bitcoin price to negative news was much stronger than to positive and neutral news. This finding suggests that the asymmetric relationship between the Bitcoin price and news sentiment was evident. GARCH-based volatility and what-if scenario analyses further demonstrated that negative sentiment leads to sharper fluctuations in the Bitcoin price. The paper provides important implications for policymakers, portfolio managers, investors, and academics. © 2025 John Wiley & Sons Ltd.},
	author_keywords = {Bitcoin price; deep learning; machine learning; news sentiment analysis; NLP},
	keywords = {Bitcoin; Costs; Electronic trading; Financial markets; Investments; Learning systems; Semantics; Sentiment analysis; Bitcoin price; Deep learning; Financial factors; Financial news; Financial variables; Machine-learning; News sentiment analyze; Semantic features; Sentiment analysis; Sentiment scores; Deep learning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Tabe2026,
	author = {Tabe, Fatemeh and Mansourabady, Ali and Rasekh, Amir Hossein and Tanoori, Betsabeh},
	title = {Proposing a hybrid deep learning model with sentiment and historical data for cryptocurrencies price prediction},
	year = {2026},
	journal = {Expert Systems with Applications},
	volume = {302},
	pages = {},
	doi = {10.1016/j.eswa.2025.130540},
	url = {https://www.scopus.com/pages/publications/105029576047?origin=resultslist},
	abstract = {The rapid growth and fluctuations in the cryptocurrency market have attracted significant attention in the development of predictive models. However, many existing studies rely solely on historical price data or use single deep learning models, which often fail to capture the complex and dynamic nature of the market. Moreover, the limited use of sentiment information from news sources has restricted prediction accuracy in previous work. To address these limitations, this article investigates a hybrid deep learning approach that combines CNN and GRU to enhance the accuracy and reliability of predicting the prices of Bitcoin (BTC), Ethereum (ETH), and Monero (XMR). The proposed model integrates both historical price data and Google news sentiment, extracted using widely used tools such as Flair, Vader, and TextBlob. Extensive experiments on diverse datasets demonstrate that the model outperforms existing approaches across multiple evaluation metrics (MAE, MAPE, MSE, RMSE). By simultaneously leveraging spatial and temporal features, the framework captures complex patterns and adapts effectively to market fluctuations. The findings confirm that integrating sentiment analysis with deep learning provides a more robust solution for cryptocurrency price prediction compared to prior studies. © 2025 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Bitcoin; Cryptocurrency prediction; Hybrid deep learning; Machine learning; News sentiment analysis},
	keywords = {Costs; Deep learning; Forecasting; Learning systems; Reliability analysis; Sentiment analysis; Text mining; Cryptocurrency prediction; Historical data; Hybrid deep learning; Learning models; Machine-learning; News sentiment analyze; Predictive models; Price prediction; Rapid growth; Sentiment analysis; Bitcoin},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

